# Supabase > Project Settings > API. Only public credentials belong in the web app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public, fictional read-only preview. Set false to hide /demo.
DEMO_ENABLED=true
# Only for scripts/seed-users.mjs in a disposable development project:
# SUPABASE_SECRET_KEY=
# SEED_PASSWORD=
# ALLOW_DEVELOPMENT_SEED=yes
